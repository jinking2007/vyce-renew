{
  "name": "vyce-renew",
  "version": "1.0.0",
  "private": true,
  "description": "Automatically renew free servers on vyce.cloud every 24 hours",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "login": "node --env-file-if-exists=.env src/cli.js login",
    "renew": "node --env-file-if-exists=.env src/cli.js renew",
    "renew:ui": "node --env-file-if-exists=.env src/cli.js renew --ui",
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "daemon": "node --env-file-if-exists=.env src/cli.js daemon",
    "export-cookie": "node --env-file-if-exists=.env src/cli.js export-cookie",
    "test": "node --test"
  },
  "keywords": [
    "vyce",
    "renew",
    "vps",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
