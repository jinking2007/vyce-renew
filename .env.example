# ---------------------------------------------------------------------------
# 认证（二选一）
# ---------------------------------------------------------------------------
# 方式 A：本地运行 `npm run login` 登录后，会话会保存到 .auth/state.json。
# 方式 B：从浏览器复制 vyce.cloud 的 Cookie 请求头，粘贴到这里。
#         例如：VYCE_COOKIE="vyce_session=xxxxxxxx; other=yyyy"
#         注意：Cookie 等同于账号密码，请勿提交到 Git。
# VYCE_COOKIE=

# 会话文件位置（默认 ./.auth/state.json）
# VYCE_STATE_PATH=.auth/state.json

# ---------------------------------------------------------------------------
# 续期策略
# ---------------------------------------------------------------------------
# 站点地址（一般不用改）
# VYCE_BASE_URL=https://vyce.cloud

# 只处理指定的服务器（ID 或名称，逗号分隔）。留空表示全部免费服务器。
# VYCE_SERVERS=

# 剩余时间小于等于该小时数时才续期。站点规则是 24 小时冷却，不建议大于 24。
# VYCE_THRESHOLD_HOURS=24

# 距续期窗口只差几分钟时，等待后重试（解决每天固定时间运行差几秒的问题）
# VYCE_COOLDOWN_GRACE_MINUTES=5

# daemon 模式的检查间隔（小时）
# VYCE_INTERVAL_HOURS=24

# 试运行：只打印计划，不真正调用续期接口
# VYCE_DRY_RUN=false

# ---------------------------------------------------------------------------
# 浏览器模式（npm run login / npm run renew:ui）
# ---------------------------------------------------------------------------
# 是否无头运行。首次登录必须为 false（会弹出窗口让你用 GitHub 登录）。
# VYCE_HEADLESS=true

# CAPTCHA：API 被拦时，用真实浏览器点击 “I'm not a robot” 验证框
# VYCE_CAPTCHA_BROWSER=true
# VYCE_CAPTCHA_TIMEOUT_SECONDS=60

# 浏览器通道：留空优先用 Playwright 自带 Chromium，失败后回退系统 Chrome；
# GitHub Actions 自带 Chrome，可不用安装
# VYCE_BROWSER_CHANNEL=chrome

# 登录等待超时（秒）
# VYCE_LOGIN_TIMEOUT_SECONDS=600

# HTTP 超时（毫秒）
# VYCE_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Telegram 通知（可选）
# ---------------------------------------------------------------------------
# 1. 找 @BotFather 创建机器人，拿到 Bot Token
# 2. 先给机器人发一条 /start，再通过 getUpdates 或 @userinfobot 拿到 chat_id
# 3. 填到本地 .env 测试：npm run notify-test
# GitHub Actions 中把这两个值分别存为 Secret：TELEGRAM_BOT_TOKEN、TELEGRAM_CHAT_ID
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# 是否启用通知（默认 true；未配置 token/chat_id 时自动跳过）
# 设为 always：即使当天无需续期也发送一条状态（每日心跳）
# TELEGRAM_NOTIFY=true

# Telegram API 地址（一般不用改，测试时可指向本地 mock）
# TELEGRAM_API_BASE=https://api.telegram.org

